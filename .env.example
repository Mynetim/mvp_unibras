# Copie para .env e preencha. O .env real nunca vai para o repositório
# (Definition of Done: nenhuma credencial dentro do repositório).

# -----------------------------------------------------------------------------
# Neon — console.neon.tech › projeto › Connect
#
# DATABASE_URL  = string COM `-pooler` no host.
#                 Usada pela aplicação.
#
# DIRECT_URL    = a mesma string SEM `-pooler`.
#                 Usada só por `prisma migrate`. Migração cria índices e tipos,
#                 e o pooler de transação não suporta essas operações.
#
# Exemplo (repare só no `-pooler`):
#   ...@ep-cool-name-123456-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
#   ...@ep-cool-name-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Administrador Master criado por `npm run db:seed`.
# A senha é lida daqui e nunca fica gravada no código da semente.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="nome@instituicao.edu.br"
SEED_ADMIN_SENHA="troque-esta-senha"
